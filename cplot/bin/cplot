#!/usr/bin/python3
"""cplot - transient plot display for Claude Code sessions.

Recipes are the durable artefact; rendered PNGs are disposable versions of them.
Display surfaces: a VS Code webview gallery (via the vscode-R request protocol)
and a live image tab on .plots/_current.png; or, inside herdr, a terminal
viewer pane drawing with the Kitty graphics protocol (`cplot view`).

stdlib only, system python3, conda-independent.
"""
import argparse, base64, difflib, hashlib, json, os, re, select, shutil, signal, \
       struct, subprocess, sys, tempfile, time
from datetime import datetime

SHARE      = os.path.expanduser("~/.local/share/cplot")
CFG_DIR    = os.path.expanduser("~/.config/cplot")
CFG        = os.path.join(CFG_DIR, "config.json")
VSCODE_R   = os.path.expanduser("~/.vscode-R")
KEEP       = 20
MARKERS    = ("_targets.yaml", ".git", "pyproject.toml", ".dsproject")
CACHE_ROOT = os.path.expanduser("~/.cache/cplot")

def die(msg, code=1):
    print("cplot: " + msg, file=sys.stderr); sys.exit(code)

def load(path, default):
    try:
        with open(path) as f: return json.load(f)
    except Exception: return default

def save(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f: json.dump(obj, f, indent=1)
    os.replace(tmp, path)

# ---------------------------------------------------------------- project layout
def project_root(start=None):
    d = os.path.abspath(start or os.getcwd())
    while True:
        if any(os.path.exists(os.path.join(d, m)) for m in MARKERS) or \
           any(f.endswith(".Rproj") for f in os.listdir(d)):
            return d
        p = os.path.dirname(d)
        if p == d: return os.path.abspath(start or os.getcwd())
        d = p

# ---------------------------------------------------------------- session scoping
# Plots live outside the project entirely, under a directory keyed to this one
# Claude session, so they are never committed, never accumulate across sessions,
# and disappear (via the sweep below) once the session's process is gone.

def session_id():
    return os.environ.get("CLAUDE_CODE_SESSION_ID", "default")

def is_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except (PermissionError, ValueError, TypeError):
        return True  # can't tell (different owner, malformed) - assume alive, don't delete on a guess

def project_cache_root(root):
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", os.path.basename(root.rstrip("/"))) or "project"
    h = hashlib.sha256(os.path.realpath(root).encode()).hexdigest()[:8]
    return os.path.join(CACHE_ROOT, f"{slug}-{h}")

def sweep_stale_sessions(cache_root, keep):
    """Delete other sessions' plot directories for this project once their
    Claude process has exited. Runs on every cplot invocation, so cleanup
    lands the next time cplot is touched anywhere - yours or anyone else's."""
    if not os.path.isdir(cache_root): return
    for sid in os.listdir(cache_root):
        if sid == keep or sid.startswith("."): continue
        sdir = os.path.join(cache_root, sid)
        info = load(os.path.join(sdir, "_session.json"), None)
        pid = info.get("pid") if info else None
        if not pid or not is_alive(pid):
            shutil.rmtree(sdir, ignore_errors=True)

def plots_dir(root=None):
    root = root or project_root()
    sid = session_id()
    d = os.path.join(project_cache_root(root), sid)
    os.makedirs(d, exist_ok=True)
    if sid != "default":
        save(os.path.join(d, "_session.json"),
             {"pid": os.environ.get("CLAUDE_PID", ""), "session_id": sid,
              "project": root, "ts": datetime.now().strftime("%Y-%m-%d %H:%M:%S")})
        sweep_stale_sessions(project_cache_root(root), sid)
    return d

def panel_title():
    root = project_root()
    sid = session_id()
    tag = sid[:8] if sid != "default" else "default"
    return f"cplot: {os.path.basename(root)} \u00b7 {tag}"

def plot_names(pd):
    """Plots in the order they were first rendered, so a new plot is appended
    and a plot's number stays put when it gets new versions."""
    names = sorted(n for n in os.listdir(pd)
                   if not n.startswith(("_", ".")) and os.path.isdir(os.path.join(pd, n)))
    return sorted(names, key=lambda n: created_at(pd, n))

def created_at(pd, name):
    d = os.path.join(pd, name)
    try: return float(open(os.path.join(d, "created")).read())
    except (OSError, ValueError): pass
    # plots rendered before the stamp existed: fall back to their oldest version
    ts = [os.stat(os.path.join(d, f)).st_mtime for f in os.listdir(d)
          if re.fullmatch(r"v\d{3}\.json", f)]
    return min(ts) if ts else float("inf")   # scaffolded, never rendered

def recipe_path(pd, name):
    for ext in ("R", "py"):
        p = os.path.join(pd, name, "recipe." + ext)
        if os.path.exists(p): return p
    return None

def versions(pd, name):
    d = os.path.join(pd, name)
    if not os.path.isdir(d): return []
    vs = sorted(int(m.group(1)) for m in
                (re.fullmatch(r"v(\d{3})\.json", f) for f in os.listdir(d)) if m)
    return vs

# ---------------------------------------------------------------- front matter
def front_matter(path):
    fm = {}
    with open(path) as f:
        for line in f:
            s = line.strip()
            if s.startswith("#|"):
                body = s[2:].strip()
                if ":" in body:
                    k, v = body.split(":", 1); fm[k.strip()] = v.strip()
            elif s and not s.startswith("#"):
                break
    return fm

def parse_size(s, default=(8.0, 5.0)):
    if not s: return default
    m = re.fullmatch(r"\s*([\d.]+)\s*[xX*]\s*([\d.]+)\s*", s)
    return (float(m.group(1)), float(m.group(2))) if m else default

def conda_binary():
    """Find a real conda executable, not the shell function `conda init` installs
    (shutil.which alone would miss that - it only sees files on PATH, and a shell
    function isn't one). $CONDA_EXE is what conda's own init script points at the
    real binary with, so it is checked first."""
    for c in (os.environ.get("CONDA_EXE"), shutil.which("conda"), shutil.which("mamba")):
        if c and os.path.exists(c):
            return c
    for base in ("~/miniconda3", "~/anaconda3", "~/miniforge3", "~/mambaforge",
                 "~/miniforge", "/opt/miniconda3", "/opt/anaconda3", "/opt/conda"):
        for sub in ("condabin/conda", "bin/conda"):
            c = os.path.expanduser(os.path.join(base, sub))
            if os.path.exists(c):
                return c
    return None

def conda_envs():
    """Map env name -> prefix path. `conda env list --json` is authoritative -
    it is the only thing that also finds envs created outside the default envs_dirs
    (e.g. a project env under a shared filesystem path via `conda create -p`), which
    no amount of scanning ~/miniconda3-style directories would find."""
    envs = {}
    exe = conda_binary()
    if exe:
        try:
            r = subprocess.run([exe, "env", "list", "--json"],
                               capture_output=True, text=True, timeout=15)
            data = json.loads(r.stdout)
            root = data.get("root_prefix") or data.get("conda_prefix")
            for p in data.get("envs", []):
                envs["base" if p == root else os.path.basename(p)] = p
        except Exception:
            pass
    if not envs:
        for base in ("~/miniconda3", "~/anaconda3", "~/miniforge3", "~/mambaforge",
                     "~/miniforge", "/opt/miniconda3", "/opt/anaconda3", "/opt/conda"):
            envdir = os.path.expanduser(os.path.join(base, "envs"))
            if os.path.isdir(envdir):
                for name in os.listdir(envdir):
                    envs.setdefault(name, os.path.join(envdir, name))
    return envs

def interpreter(lang, env):
    exe = "Rscript" if lang == "r" else "python"
    if env:
        envs = conda_envs()
        prefix = envs.get(env)
        if not prefix:
            avail = ", ".join(sorted(envs)) or "(none found - is conda on PATH or $CONDA_EXE set?)"
            die(f"conda env '{env}' not found\n  available: {avail}")
        p = os.path.join(prefix, "bin", exe)
        if not os.path.exists(p):
            die(f"env '{env}' ({prefix}) has no {exe} at {p}")
        return p
    p = shutil.which(exe) or shutil.which(exe + "3")
    if not p: die(f"no {exe} on PATH; declare '#| env: <conda-env>' in the recipe")
    return p

# ---------------------------------------------------------------- vscode wd
def discover_wd():
    cfg = load(CFG, {})
    req = load(os.path.join(VSCODE_R, "request.log"), None)
    if isinstance(req, dict) and not req.get("cplot") and req.get("wd"):
        if req["wd"] != cfg.get("vscode_wd"):
            cfg["vscode_wd"] = req["wd"]; save(CFG, cfg)
    return cfg.get("vscode_wd")

def open_panel(gallery_file, title="cplot gallery", viewer="Two"):
    """Open the gallery as a local-file webview.

    Deliberately NOT a forwarded http:// URL: the VS Code server may run on a
    different compute node than this session, so the webview's localhost is not
    ours. Shared-filesystem resource loading works across nodes; ports do not.
    """
    wd = discover_wd()
    if not wd:
        print("cplot: don't know this window's VS Code workspace path yet.\n"
              "  Run any plot in an R terminal once (httpgd writes it), or:\n"
              "    cplot config --wd /path/to/vscode/workspace/folder\n"
              f"  Gallery file is {gallery_file}", file=sys.stderr)
        return False
    req = {"time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "pid": os.getpid(),
           "wd": wd, "command": "webview", "file": os.path.abspath(gallery_file),
           "title": title, "viewer": viewer, "cplot": True}
    with open(os.path.join(VSCODE_R, "request.log"), "w") as f:
        json.dump(req, f, separators=(",", ":")); f.write("\n")
    with open(os.path.join(VSCODE_R, "request.lock"), "w") as f:
        f.write("%.6f" % time.time())
    return True

def open_live_tab(pd):
    cur = os.path.join(pd, "_current.png")
    if not os.path.exists(cur): return
    code = shutil.which("code")
    if not code: return
    marker = os.path.join(pd, "_tab_opened")
    if os.path.exists(marker): return
    subprocess.run([code, "-r", cur], capture_output=True)
    open(marker, "w").write(str(time.time()))
    print("  live tab opened - drag it into a bottom editor group once; it stays there.")

# ---------------------------------------------------------------- manifest
def build_manifest(pd):
    plots = []
    for name in plot_names(pd):
        d = os.path.join(pd, name)
        rp = recipe_path(pd, name)
        fm = front_matter(rp) if rp else {}
        vs = []
        for v in versions(pd, name):
            meta = load(os.path.join(d, f"v{v:03d}.json"), {})
            ext = "R" if (meta.get("lang") == "r") else "py"
            code = ""
            cp_ = os.path.join(d, f"v{v:03d}.{ext}")
            if os.path.exists(cp_):
                code = open(cp_).read()
            png = f"{name}/v{v:03d}.png"
            if not os.path.exists(os.path.join(pd, png)): continue
            vs.append({"v": v, "png": png, "ts": meta.get("ts", ""),
                       "dims": meta.get("dims", ""), "runtime": meta.get("runtime", 0),
                       "title": meta.get("title", ""), "caption": meta.get("caption", ""),
                       "code": code})
        if not vs: continue
        lang = "r" if (rp or "").endswith(".R") else ("py" if rp else "")
        if not lang:
            last = load(os.path.join(d, f"v{versions(pd, name)[-1]:03d}.json"), {})
            lang = last.get("lang", "")
        plots.append({"name": name, "lang": lang,
                      "env": fm.get("env", ""), "versions": vs,
                      "failed": os.path.exists(os.path.join(d, "last_error.txt"))})
    save(os.path.join(pd, "_manifest.json"),
         {"generated": datetime.now().strftime("%H:%M:%S"), "plots": plots})
    return plots

# ---------------------------------------------------------------- run
TEMPLATE_R = '''#| name: {name}
#| env:  {env}
#| title:   {name}
#| caption: one concise sentence saying what this shows
#| size: 8x5
#| dpi:  150

library(ggplot2)

d <- data.frame(x = 1:10, y = (1:10)^2)
p <- ggplot(d, aes(x, y)) + geom_point() + theme_minimal()

cp(p)
'''

TEMPLATE_PY = '''#| name: {name}
#| env:  {env}
#| title:   {name}
#| caption: one concise sentence saying what this shows
#| size: 8x5
#| dpi:  150

import matplotlib.pyplot as plt

fig, ax = plt.subplots()
ax.plot(range(10), [v**2 for v in range(10)], "o-")

cp(fig)
'''

def cmd_new(args):
    pd = plots_dir()
    name = args.name
    d = os.path.join(pd, name); os.makedirs(d, exist_ok=True)
    ext = "R" if args.lang == "r" else "py"
    p = os.path.join(d, "recipe." + ext)
    if os.path.exists(p) and not args.force:
        die(f"{p} exists (use --force to overwrite)")
    tpl = TEMPLATE_R if args.lang == "r" else TEMPLATE_PY
    env = args.env or ("latest-r" if args.lang == "r" else "spatial-py")
    with open(p, "w") as f: f.write(tpl.format(name=name, env=env))
    print(p)

def cmd_run(args):
    root = project_root(); pd = plots_dir(root)
    name = args.name
    rp = recipe_path(pd, name)
    if not rp: die(f"no recipe for '{name}' (try: cplot new {name} --lang r)")
    lang = "r" if rp.endswith(".R") else "py"
    fm = front_matter(rp)
    w, h = parse_size(args.size or fm.get("size"))
    dpi = float(args.dpi or fm.get("dpi") or 150)
    env = args.env or fm.get("env")
    exe = interpreter(lang, env)

    stage = tempfile.mkdtemp(prefix="cplot-")
    e = dict(os.environ)
    e.update({"CPLOT_STAGE": stage, "CPLOT_NAME": name, "CPLOT_W": str(w),
              "CPLOT_H": str(h), "CPLOT_DPI": str(dpi),
              "CPLOT_SVG": "1" if (args.svg or fm.get("svg") in ("1", "true", "TRUE", "yes")) else "",
              "CPLOT_SHIM": os.path.join(SHARE, "shim.R"),
              "CPLOT_RECIPE": os.path.abspath(rp),
              "MPLBACKEND": "Agg"})
    if lang == "r":
        cmd = [exe, "-e",
               'source(Sys.getenv("CPLOT_SHIM")); '
               'sys.source(Sys.getenv("CPLOT_RECIPE"), envir = globalenv())']
    else:
        cmd = [exe, os.path.join(SHARE, "boot.py"), os.path.abspath(rp)]

    t0 = time.time()
    r = subprocess.run(cmd, cwd=root, env=e, capture_output=True, text=True)
    dt = round(time.time() - t0, 2)
    errfile = os.path.join(pd, name, "last_error.txt")

    if r.returncode != 0:
        with open(errfile, "w") as f:
            f.write(f"# {datetime.now():%Y-%m-%d %H:%M:%S}  exit {r.returncode}\n\n")
            f.write(r.stdout or ""); f.write("\n"); f.write(r.stderr or "")
        build_manifest(pd)
        print(f"cplot: recipe FAILED (exit {r.returncode}) after {dt}s - no version created",
              file=sys.stderr)
        print((r.stderr or r.stdout or "").strip()[-4000:], file=sys.stderr)
        shutil.rmtree(stage, ignore_errors=True)
        sys.exit(1)
    if os.path.exists(errfile): os.remove(errfile)

    emitted = []
    jl = os.path.join(stage, "emitted.jsonl")
    if os.path.exists(jl):
        with open(jl) as f:
            emitted = [json.loads(l) for l in f if l.strip()]
    if not emitted:
        shutil.rmtree(stage, ignore_errors=True)
        die(f"recipe ran but emitted no plots - did you call cp(...)?\n{(r.stdout or '')[-2000:]}")

    out_paths = []
    for em in emitted:
        pname = em["name"]
        pdir = os.path.join(pd, pname); os.makedirs(pdir, exist_ok=True)
        stamp = os.path.join(pdir, "created")
        if not os.path.exists(stamp):
            t = created_at(pd, pname)   # a plot rendered before stamps keeps its place
            open(stamp, "w").write("%.6f" % (time.time() if t == float("inf") else t))
        v = (versions(pd, pname)[-1] + 1) if versions(pd, pname) else 1
        tag = f"v{v:03d}"
        dst = os.path.join(pdir, tag + ".png")
        tmp = dst + ".tmp"
        shutil.copyfile(em["png"], tmp); os.replace(tmp, dst)
        if em.get("svg") and os.path.exists(em["svg"]):
            shutil.copyfile(em["svg"], os.path.join(pdir, tag + ".svg"))
        ext = "R" if lang == "r" else "py"
        shutil.copyfile(rp, os.path.join(pdir, f"{tag}.{ext}"))
        save(os.path.join(pdir, tag + ".json"),
             {"ts": datetime.now().strftime("%H:%M:%S"), "lang": lang, "env": env or "",
              "title": args.title or fm.get("title", ""),
              "caption": args.caption or fm.get("caption", ""),
              "dims": f"{em.get('w', w)}x{em.get('h', h)} in @ {int(em.get('dpi', dpi))} dpi",
              "runtime": dt, "bytes": os.path.getsize(dst),
              "sha": hashlib.sha256(open(rp, 'rb').read()).hexdigest()[:12]})
        out_paths.append(dst)

    cur = os.path.join(pd, "_current.png")
    with open(out_paths[-1], "rb") as src, open(cur, "wb") as dstf:
        dstf.write(src.read())
    build_manifest(pd)
    shutil.rmtree(stage, ignore_errors=True)
    prune(pd, args.keep)

    if r.stdout.strip(): print(r.stdout.strip())
    for p in out_paths: print(p)

def prune(pd, keep=KEEP):
    keep = keep or KEEP
    for name in plot_names(pd):
        vs = versions(pd, name)
        for v in vs[:-keep] if len(vs) > keep else []:
            for f in os.listdir(os.path.join(pd, name)):
                if f.startswith(f"v{v:03d}."):
                    os.remove(os.path.join(pd, name, f))

# ---------------------------------------------------------------- commands
def gallery_file(pd):
    dst = os.path.join(pd, "_gallery.html")
    shutil.copyfile(os.path.join(SHARE, "gallery.html"), dst)
    return dst

def use_terminal(args):
    if getattr(args, "vscode", False): return False
    return getattr(args, "term", False) or os.environ.get("HERDR_ENV") == "1"

def cmd_serve(args):
    root = project_root(); pd = plots_dir(root)
    if use_terminal(args):
        build_manifest(pd)
        open_herdr_viewer(pd, root)
        return
    g = gallery_file(pd); build_manifest(pd)
    print(f"cplot: gallery {g}")
    if open_panel(g, title=panel_title()): print("  panel opened in VS Code (no server, no port)")
    open_live_tab(pd)

def cmd_open(args):
    root = project_root(); pd = plots_dir(root)
    if use_terminal(args):
        build_manifest(pd)
        open_herdr_viewer(pd, root)
        return
    g = gallery_file(pd); build_manifest(pd)
    print("panel opened" if open_panel(g, title=panel_title()) else g)

# ---------------------------------------------------------------- herdr viewer pane
# Inside herdr, the display surface is a sibling pane running `cplot view --dir`.
# Unlike a VS Code webview, a pane can be found again, so serve/open are
# idempotent here: the pane id is remembered per session and reused while alive.

def herdr_bin():
    return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr")

def herdr_json(*argv):
    h = herdr_bin()
    if not h: return None
    r = subprocess.run([h, *argv], capture_output=True, text=True)
    try: return json.loads(r.stdout)
    except Exception: return None

def open_herdr_viewer(pd, root):
    h = herdr_bin()
    if not h or not os.environ.get("HERDR_PANE_ID"):
        print("cplot: not inside a herdr pane - run the viewer yourself in a pane\n"
              f"  of a Kitty-graphics terminal:  cplot view --dir {pd}")
        return False
    vf = os.path.join(pd, "_viewer.json")
    info = load(vf, {})
    pid = info.get("pane_id")
    if pid:
        got = herdr_json("pane", "get", pid)
        if got and "result" in got:
            print(f"cplot: viewer already open in herdr pane {pid}")
            return True
    got = herdr_json("pane", "split", "--current", "--direction", "right",
                     "--ratio", "0.55", "--cwd", root, "--no-focus")
    try:
        pid = got["result"]["pane"]["pane_id"]
    except Exception:
        die(f"herdr pane split failed: {got}")
    me = os.path.realpath(sys.argv[0])
    subprocess.run([h, "pane", "run", pid, f"exec {sh_quote(me)} view --dir {sh_quote(pd)}"],
                   capture_output=True)
    subprocess.run([h, "pane", "rename", pid, "cplot"], capture_output=True)
    save(vf, {"pane_id": pid, "ts": datetime.now().strftime("%Y-%m-%d %H:%M:%S")})
    print(f"cplot: viewer opened in herdr pane {pid} (Kitty graphics, no server, no port)")
    return True

def sh_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"

# ---------------------------------------------------------------- terminal viewer
# Draws PNGs with the Kitty graphics protocol, written by hand so nothing beyond
# system python3 is needed on the compute node. Images travel inside the
# terminal byte stream, so they follow any ssh/srun/herdr hop the text does.

def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n": return None
    return struct.unpack(">II", head[16:24])

def kitty_image(path, cols, rows):
    data = base64.b64encode(open(path, "rb").read())
    out, first = [], True
    for i in range(0, len(data), 4096):
        chunk = data[i:i + 4096]
        more = 1 if i + 4096 < len(data) else 0
        keys = f"a=T,f=100,q=2,C=1,c={cols},r={rows},m={more}" if first else f"m={more}"
        out.append(b"\x1b_G" + keys.encode() + b";" + chunk + b"\x1b\\")
        first = False
    return b"".join(out)

KITTY_CLEAR = b"\x1b_Ga=d,d=A,q=2\x1b\\"

class Term:
    def __init__(self):
        import termios, tty
        self.termios, self.fd = termios, sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        self.w(b"\x1b[?1049h\x1b[?25l")

    def close(self):
        self.w(KITTY_CLEAR + b"\x1b[?25h\x1b[?1049l")
        self.termios.tcsetattr(self.fd, self.termios.TCSADRAIN, self.saved)

    def w(self, b):
        os.write(sys.stdout.fileno(), b if isinstance(b, bytes) else b.encode())

    def read(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        return os.read(self.fd, 4096) if r else b""

    def query(self, q, until, timeout=0.5):
        self.w(q)
        buf, end = b"", time.time() + timeout
        while time.time() < end and not re.search(until, buf):
            buf += self.read(max(0.0, end - time.time()))
        return buf

    def size(self):
        import fcntl, termios
        rows, cols, xp, yp = struct.unpack("HHHH", fcntl.ioctl(
            sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
        return cols, rows, xp, yp

    def kitty_supported(self):
        # Graphics query, then primary DA: a terminal that ignores the query
        # still answers DA, so we never wait out the full timeout.
        buf = self.query(b"\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\\x1b[c", rb"\x1b\[\?[\d;]*c")
        return b"_Gi=31;OK" in buf

    def cell_px(self):
        if getattr(self, "_cell", None): return self._cell
        self._cell = self._measure_cell()
        return self._cell

    def _measure_cell(self):
        cols, rows, xp, yp = self.size()
        if xp and yp: return xp / cols, yp / rows
        m = re.search(rb"\x1b\[6;(\d+);(\d+)t", self.query(b"\x1b[16t", rb"\x1b\[6;\d+;\d+t", 0.3))
        if m: return int(m.group(2)), int(m.group(1))
        return 10.0, 21.0

def fit_cells(img_w, img_h, cols, rows, cw, ch):
    c = cols
    r = max(1, round(c * cw * img_h / img_w / ch))
    if r > rows:
        r = rows
        c = max(1, round(r * ch * img_w / img_h / cw))
    return min(c, cols), r

def trunc(s, n):
    return s if len(s) <= n else s[:max(0, n - 1)] + "…"

class Viewer:
    KEYS = {b"\x1b[C": "right", b"\x1b[D": "left", b"\x1b[A": "up", b"\x1b[B": "down",
            b"\x1bOC": "right", b"\x1bOD": "left", b"\x1bOA": "up", b"\x1bOB": "down",
            b"l": "right", b"h": "left", b"k": "up", b"j": "down"}

    def __init__(self, pd, mode):
        self.pd, self.mode = pd, mode
        self.plots, self.pi, self.vi = [], 0, -1
        self.code, self.scroll, self.mtime = False, 0, None
        self.dirty = True

    def reload(self):
        mf = os.path.join(self.pd, "_manifest.json")
        try: mt = os.stat(mf).st_mtime_ns
        except FileNotFoundError: mt = None
        if mt == self.mtime: return
        self.mtime = mt
        old = {p["name"]: len(p["versions"]) for p in self.plots}
        cur = self.plots[self.pi]["name"] if self.plots else None
        self.plots = load(mf, {}).get("plots", [])
        grew = [i for i, p in enumerate(self.plots) if len(p["versions"]) > old.get(p["name"], 0)]
        if grew and old:
            self.pi, self.vi, self.code = grew[0], -1, False   # follow the newest render
        else:
            names = [p["name"] for p in self.plots]
            self.pi = names.index(cur) if cur in names else 0
            if self.plots and self.vi >= len(self.plots[self.pi]["versions"]): self.vi = -1
        self.dirty = True

    def key(self, k):
        if not self.plots: return
        n = len(self.plots[self.pi]["versions"])
        vi = self.vi % n
        if self.code and k in ("up", "down"):
            self.scroll = max(0, self.scroll + (1 if k == "down" else -1) * 5)
        elif k == "right": self.pi, self.vi, self.scroll = (self.pi + 1) % len(self.plots), -1, 0
        elif k == "left":  self.pi, self.vi, self.scroll = (self.pi - 1) % len(self.plots), -1, 0
        elif k == "up":    self.vi = max(0, vi - 1)
        elif k == "down":  self.vi = min(n - 1, vi + 1)
        else: return
        self.dirty = True

    def draw(self, t):
        cols, rows, _, _ = t.size()
        out = [KITTY_CLEAR, b"\x1b[2J\x1b[H"]
        if not self.plots:
            out.append(b"\x1b[2mcplot: no plots yet in this session - `cplot run <name>`\x1b[0m")
            t.w(b"".join(out)); return
        p = self.plots[self.pi]; vs = p["versions"]; v = vs[self.vi % len(vs)]
        vn = self.vi % len(vs) + 1
        fail = "  \x1b[31mlast run FAILED\x1b[0m" if p.get("failed") else ""
        head = (f"\x1b[1m{p['name']}\x1b[0m  v{v['v']:03d} ({vn}/{len(vs)})"
                f"  \x1b[2m[{self.pi + 1}/{len(self.plots)}] {v.get('ts', '')}\x1b[0m{fail}")
        out.append(head.encode())
        foot = f"←→ plot  ↑↓ version  c code  z zoom  r redraw  q quit  [{self.mode}]"
        cap = v.get("title") or ""
        if v.get("caption"): cap += (" — " if cap else "") + v["caption"]
        body = rows - 3
        if self.code:
            self.draw_code(out, p, vs, cols, body)
        else:
            png = os.path.join(self.pd, v["png"])
            dims = png_size(png) if os.path.exists(png) else None
            if dims and self.mode == "kitty":
                cw, ch = t.cell_px()
                c, r = fit_cells(dims[0], dims[1], cols, body, cw, ch)
                out.append(f"\x1b[2;{max(1, (cols - c) // 2 + 1)}H".encode())
                out.append(kitty_image(png, c, r))
            elif dims and self.mode == "chafa":
                r = subprocess.run(["chafa", "-s", f"{cols}x{body}", png], capture_output=True)
                out.append(b"\x1b[2;1H" + r.stdout.replace(b"\n", b"\r\n"))
            else:
                out.append(f"\x1b[3;1H(no inline graphics here)\r\n{png}".encode())
        out.append(f"\x1b[{rows - 1};1H{trunc(cap, cols)}".encode())
        out.append(f"\x1b[{rows};1H\x1b[2m{trunc(foot, cols)}\x1b[0m".encode())
        t.w(b"".join(out))

    def draw_code(self, out, p, vs, cols, body):
        i = self.vi % len(vs)
        now = vs[i].get("code", "").splitlines()
        if i > 0:
            prev = vs[i - 1].get("code", "").splitlines()
            lines = list(difflib.unified_diff(prev, now, f"v{vs[i-1]['v']:03d}",
                                              f"v{vs[i]['v']:03d}", lineterm="", n=99))[2:] or now
        else:
            lines = now
        self.scroll = min(self.scroll, max(0, len(lines) - body))
        out.append(b"\x1b[2;1H")
        for ln in lines[self.scroll:self.scroll + body]:
            col = "\x1b[32m" if ln.startswith("+") else "\x1b[31m" if ln.startswith("-") \
                  else "\x1b[36m" if ln.startswith("@@") else ""
            out.append(f"{col}{trunc(ln, cols)}\x1b[0m\r\n".encode())

def cmd_view(args):
    pd = os.path.abspath(args.dir) if args.dir else plots_dir()
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("cplot view needs an interactive terminal")
    t = Term()
    winch = [False]
    signal.signal(signal.SIGWINCH, lambda *_: winch.__setitem__(0, True))
    try:
        mode = args.mode
        if mode == "auto":
            mode = "kitty" if t.kitty_supported() else ("chafa" if shutil.which("chafa") else "text")
        v = Viewer(pd, mode)
        while True:
            if not os.path.isdir(pd):
                break   # session swept: its plots are gone, so is the viewer
            v.reload()
            if winch[0]: winch[0], v.dirty, t._cell = False, True, None
            if v.dirty: v.draw(t); v.dirty = False
            b = t.read(0.75)
            if not b: continue
            if b in (b"q", b"\x03"): break
            if b == b"c": v.code, v.scroll, v.dirty = not v.code, 0, True
            elif b == b"r": v.dirty = True
            elif b == b"z" and herdr_bin() and os.environ.get("HERDR_PANE_ID"):
                subprocess.run([herdr_bin(), "pane", "zoom", "--pane", os.environ["HERDR_PANE_ID"], "--toggle"],
                               capture_output=True)
            else:
                v.key(Viewer.KEYS.get(b, ""))
    finally:
        t.close()
    if not os.path.isdir(pd):
        print("cplot: this session's plots are gone (session ended) - viewer closed")

def cmd_clear(args):
    pd = plots_dir()
    if args.all:
        names = plot_names(pd)
        for name in names:
            shutil.rmtree(os.path.join(pd, name), ignore_errors=True)
        build_manifest(pd)
        print(f"cplot: cleared {len(names)} plot(s) in this session")
        return
    if not args.name:
        die("specify a plot name, or use --all")
    d = os.path.join(pd, args.name)
    if not os.path.isdir(d):
        die(f"no such plot '{args.name}'")
    if args.version:
        try:
            vi = int(args.version.lstrip("vV"))
        except ValueError:
            die(f"bad version '{args.version}' (expected e.g. v003 or 3)")
        tag = f"v{vi:03d}"
        removed = [f for f in os.listdir(d) if f.startswith(tag + ".")]
        if not removed:
            die(f"no version {tag} for '{args.name}'")
        for f in removed: os.remove(os.path.join(d, f))
        if versions(pd, args.name):
            build_manifest(pd)
            print(f"cplot: cleared {tag} of '{args.name}'")
        else:
            shutil.rmtree(d, ignore_errors=True)
            build_manifest(pd)
            print(f"cplot: cleared {tag} of '{args.name}' (no versions left, removed the plot)")
        return
    shutil.rmtree(d)
    build_manifest(pd)
    print(f"cplot: cleared '{args.name}'")

def cmd_list(args):
    pd = plots_dir()
    for name in plot_names(pd):
        vs = versions(pd, name)
        rp = recipe_path(pd, name)
        origin = ""
        if not rp:
            for parent in plot_names(pd):
                if name.startswith(parent + "-") and recipe_path(pd, parent):
                    origin = f"from {parent}"; break
        fail = " FAILED" if os.path.exists(os.path.join(pd, name, "last_error.txt")) else ""
        label = os.path.basename(rp) if rp else (origin or "-")
        print(f"{name:32} {len(vs):3d} versions  {label:14}{fail}")

def cmd_log(args):
    pd = plots_dir()
    for v in versions(pd, args.name):
        m = load(os.path.join(pd, args.name, f"v{v:03d}.json"), {})
        print(f"v{v:03d}  {m.get('ts','')}  {m.get('runtime','')}s  {m.get('dims','')}  {m.get('sha','')}")

def cmd_show(args):
    pd = plots_dir()
    vs = versions(pd, args.name)
    if not vs: die(f"no versions for {args.name}")
    v = args.version or vs[-1]
    p = os.path.join(pd, args.name, f"v{int(v):03d}.png")
    if not os.path.exists(p): die(f"no {p}")
    if args.pin:
        with open(p, "rb") as s, open(os.path.join(pd, "_current.png"), "wb") as d:
            d.write(s.read())
    print(p)

def cmd_export(args):
    ns = argparse.Namespace(name=args.name, size=args.size, dpi=args.dpi, env=None,
                            svg=args.svg, keep=None, title=None, caption=None)
    cmd_run(ns)
    pd = plots_dir()
    vs = versions(pd, args.name)
    src = os.path.join(pd, args.name, f"v{vs[-1]:03d}.png")
    os.makedirs(os.path.dirname(os.path.abspath(args.to)) or ".", exist_ok=True)
    shutil.copyfile(src, args.to)
    print(args.to)

def cmd_status(args):
    root = project_root(); cache_root = project_cache_root(root)
    pd = plots_dir(root)
    print(f"session    {session_id()}")
    print(f"cache      {pd}  (outside the project - never committed, cleared when the session ends)")
    print(f"gallery    {os.path.join(pd, '_gallery.html')}")
    print(f"vscode wd  {discover_wd() or '(unknown)'}")
    print(f"plots      {len(plot_names(pd))}")
    if os.environ.get("HERDR_ENV") == "1":
        pane = load(os.path.join(pd, "_viewer.json"), {}).get("pane_id", "(not open)")
        print(f"transport  herdr pane {pane}, Kitty graphics (no server, no port)")
    else:
        print(f"transport  local-file webview (no server, no port)")
    others = [d for d in (os.listdir(cache_root) if os.path.isdir(cache_root) else [])
              if d != session_id() and not d.startswith(".")]
    if others:
        print(f"other live sessions for this project: {', '.join(sorted(others))}")

def cmd_config(args):
    cfg = load(CFG, {})
    if args.wd: cfg["vscode_wd"] = os.path.abspath(args.wd); save(CFG, cfg)
    print(json.dumps(cfg, indent=1))

def main():
    ap = argparse.ArgumentParser(prog="cplot")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("new");  p.add_argument("name"); p.add_argument("--lang", choices=["r","py"], required=True)
    p.add_argument("--env"); p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_new)

    p = sub.add_parser("run");  p.add_argument("name"); p.add_argument("--size"); p.add_argument("--dpi")
    p.add_argument("--env"); p.add_argument("--svg", action="store_true")
    p.add_argument("--title"); p.add_argument("--caption")
    p.add_argument("--keep", type=int); p.set_defaults(fn=cmd_run)

    for c, fn in (("serve", cmd_serve), ("open", cmd_open)):
        p = sub.add_parser(c)
        g = p.add_mutually_exclusive_group()
        g.add_argument("--term", action="store_true", help="herdr viewer pane (default inside herdr)")
        g.add_argument("--vscode", action="store_true", help="VS Code webview panel")
        p.set_defaults(fn=fn)
    p = sub.add_parser("view", help="terminal viewer (Kitty graphics); serve --term runs it in a herdr pane")
    p.add_argument("--dir", help="plots directory to follow (default: this session's)")
    p.add_argument("--mode", choices=["auto", "kitty", "chafa", "text"], default="auto")
    p.set_defaults(fn=cmd_view)
    p = sub.add_parser("list");  p.set_defaults(fn=cmd_list)
    p = sub.add_parser("log");   p.add_argument("name"); p.set_defaults(fn=cmd_log)
    p = sub.add_parser("show");  p.add_argument("name"); p.add_argument("version", nargs="?")
    p.add_argument("--pin", action="store_true"); p.set_defaults(fn=cmd_show)
    p = sub.add_parser("export"); p.add_argument("name"); p.add_argument("--to", required=True)
    p.add_argument("--size"); p.add_argument("--dpi"); p.add_argument("--svg", action="store_true")
    p.set_defaults(fn=cmd_export)
    p = sub.add_parser("prune"); p.add_argument("--keep", type=int, default=KEEP)
    p.set_defaults(fn=lambda a: prune(plots_dir(), a.keep))
    p = sub.add_parser("clear"); p.add_argument("name", nargs="?")
    p.add_argument("--all", action="store_true")
    p.add_argument("--version", metavar="vNNN", help="delete one version instead of the whole plot")
    p.set_defaults(fn=cmd_clear)
    p = sub.add_parser("status"); p.set_defaults(fn=cmd_status)
    p = sub.add_parser("config"); p.add_argument("--wd"); p.set_defaults(fn=cmd_config)

    a = ap.parse_args(); a.fn(a)

if __name__ == "__main__":
    main()
